# Core
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/whisked?sslmode=disable
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-32-character-string-minimum

# iOS request signing
HMAC_SHARED_KEY=change-me-to-a-random-secret

# Operator
ADMIN_PIN=changeme1

# Shopify (optional — enables loyalty credit for online orders)
SHOPIFY_WEBHOOK_SECRET=

# Square OAuth (preferred — enables in-app order creation on Belle's POS)
# One-time setup:
#   1. Create an app at developer.squareup.com
#   2. Set SQUARE_OAUTH_REDIRECT_URL to https://<your-api>/v1/square/oauth/callback
#      (must match exactly what you configure in the Square Developer dashboard)
#   3. Set SQUARE_APP_ID and SQUARE_APP_SECRET from your Square app
#   4. Visit /v1/square/oauth/connect as a staff member — Belle approves once
# After OAuth completes, SQUARE_ACCESS_TOKEN is no longer needed.
SQUARE_APP_ID=
SQUARE_APP_SECRET=
SQUARE_OAUTH_REDIRECT_URL=https://your-api.up.railway.app/v1/square/oauth/callback

# Square legacy static token (fallback — used before OAuth is completed)
# SQUARE_ACCESS_TOKEN:        from Square Developer dashboard
# SQUARE_WEBHOOK_SIGNING_KEY: from the webhook subscription in Square Developer dashboard
# SQUARE_LOCATION_ID:         your Square location ID (Jasper Ave bar)
# SQUARE_NOTIFICATION_URL:    must exactly match the webhook URL in Square dashboard
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNING_KEY=
SQUARE_LOCATION_ID=
SQUARE_NOTIFICATION_URL=

# Anthropic (optional — enables brand chat)
ANTHROPIC_API_KEY=
