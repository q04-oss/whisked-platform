# Core
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/whisked?sslmode=disable
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-32-character-string-minimum

# iOS request signing
HMAC_SHARED_KEY=change-me-to-a-random-secret

# Operator
ADMIN_PIN=changeme1

# Shopify (optional — enables loyalty credit for online orders)
SHOPIFY_WEBHOOK_SECRET=

# Square (optional — enables auto-steep on payment + QR validation)
# SQUARE_ACCESS_TOKEN:       from Square Developer dashboard (Sandbox or Production)
# SQUARE_WEBHOOK_SIGNING_KEY: from the webhook subscription in Square Developer dashboard
# SQUARE_LOCATION_ID:         your Square location ID (Jasper Ave bar)
# SQUARE_NOTIFICATION_URL:    must exactly match the webhook URL in Square dashboard
#                             e.g. https://your-api.up.railway.app/v1/loyalty/webhooks/square
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNING_KEY=
SQUARE_LOCATION_ID=
SQUARE_NOTIFICATION_URL=

# Anthropic (optional — enables brand chat)
ANTHROPIC_API_KEY=
